# Copy to .env. Only DATABASE_URL, AUTH_SECRET and ADMIN_EMAIL are needed to start.

# Local zero-config: SQLite file. Production: a Postgres URL (Neon, Supabase, ...).
DATABASE_URL="file:./dev.db"

# Signs sessions and encrypts the API keys saved in /admin. 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# First-run admin. Created automatically when the user table is empty.
ADMIN_EMAIL=you@company.co.id
# Optional. If empty, a random one-time password is printed to the server log at first sign-in attempt.
ADMIN_INITIAL_PASSWORD=

# Everything below can also be set from the /admin page (stored encrypted, overrides these).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
TRIAGE_MODEL=
SHODAN_API_KEY=
