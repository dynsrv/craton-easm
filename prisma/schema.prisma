// PostgreSQL is the default (Vercel + Neon/Supabase). For zero-config local work set
// DATABASE_URL="file:./dev.db": scripts/prisma.mjs then derives a SQLite copy of this schema.
// List fields are JSON strings so the models are identical on both databases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scan {
  id         String    @id @default(cuid())
  domain     String
  status     String    @default("queued") // queued | running | completed | failed
  phase      Int       @default(0) // 0 CT logs, 1 DNS, 2 HTTP/TLS, 3 ports/CVE, 4 triage, 5 brief, 6 done
  log        String    @default("[]") // JSON string[]
  source     String? // "crt.sh" | "dns-fallback"
  namesFound Int       @default(0)
  score      Int? // 0-100, 100 = clean
  brief      String? // JSON ExecutiveBrief
  triagedBy  String? // "llm" | "heuristic" | "mixed"
  error      String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  // v2
  attackPaths    String? // JSON AttackPath[]
  emailSecurity  String? // JSON EmailSecurity
  baselineScanId String? // previous scan this one was compared with

  assets      Asset[]
  exposures   Exposure[]
  snapshot    ScanSnapshot?
  driftEvents DriftEvent[]

  @@index([domain, createdAt])
}

model Asset {
  id       String @id @default(cuid())
  scanId   String
  scan     Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)
  hostname String

  // DNS
  ips      String  @default("[]") // JSON string[]
  cname    String?
  provider String  @default("Unknown")

  // HTTP
  scheme       String?
  httpStatus   Int?
  finalUrl     String?
  title        String?
  hasLoginForm Boolean @default(false)
  server       String?
  poweredBy    String?
  hsts         Boolean @default(false)
  csp          Boolean @default(false)

  // TLS
  tlsValid    Boolean?
  tlsDaysLeft Int?
  tlsIssuer   String?
  tlsError    String?

  // Shodan InternetDB
  ports String @default("[]") // JSON number[]
  cves  String @default("[]") // JSON string[]
  cpes  String @default("[]") // JSON string[]: software and versions Shodan saw, the reason CVEs are listed

  // AI triage
  category      String?
  severity      String?
  reasoningEn   String?
  reasoningId   String?
  remediationEn String?
  remediationId String?
  triageSource  String? // "llm" | "heuristic"

  // Visual triage (v2)
  visualClass     String?
  visualProduct   String?
  visualAnomalies String    @default("[]") // JSON Bilingual[]
  screenshot      Bytes? // JPEG 1280x800; pruned for older scans
  screenshotAt    DateTime?

  @@index([scanId])
}

/// Takeover risks, cloud buckets, public code references and email-security gaps.
model Exposure {
  id            String  @id @default(cuid())
  scanId        String
  scan          Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  kind          String // takeover | bucket | code_leak | email
  severity      String
  hostname      String?
  provider      String?
  target        String
  evidence      String // always redacted before it is stored
  titleEn       String
  titleId       String
  reasoningEn   String
  reasoningId   String
  remediationEn String
  remediationId String

  @@index([scanId])
}

/// Compact state of one completed scan, the baseline for drift detection.
model ScanSnapshot {
  id        String   @id @default(cuid())
  scanId    String   @unique
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  domain    String
  data      String // JSON SnapshotData
  createdAt DateTime @default(now())

  @@index([domain, createdAt])
}

model DriftEvent {
  id             String    @id @default(cuid())
  domain         String
  scanId         String
  scan           Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  baselineScanId String
  kind           String
  severity       String
  hostname       String?
  detailEn       String
  detailId       String
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([domain, createdAt])
}

/// Domains re-scanned automatically by the daily job.
model Monitor {
  domain    String    @id
  enabled   Boolean   @default(true)
  createdBy String?
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               String    @default("admin")
  mustChangePassword Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
}

// Backend configuration managed from /admin. Values are AES-256-GCM encrypted with AUTH_SECRET.
model Setting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// One recorded AI API call, for the admin usage and cost dashboard.
model AiUsage {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  provider     String
  model        String
  operation    String // triage | brief | attack-paths | exploit
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)

  @@index([createdAt])
}
